---
const { currentPath = '/', mobile = false } = Astro.props;

const groups = [
  {
    label: 'Overview',
    items: [
      { href: '/docs/', label: 'Introduction' },
      { href: '/docs/00-general-overview/', label: 'General Overview' },
      { href: '/docs/01-architecture/', label: 'Architecture' },
      { href: '/docs/02-repo-structure/', label: 'Repository Structure' }
    ]
  },
  {
    label: 'Runtime',
    items: [
      { href: '/docs/03-end-to-end-workflows/', label: 'End-to-End Workflows' },
      { href: '/docs/04-local-run/', label: 'Operational Commands' },
      { href: '/docs/05-docker-setup/', label: 'Docker Setup' },
      { href: '/docs/06-database/', label: 'Database' },
      { href: '/docs/07-unity-client/', label: 'Unity Client' }
    ]
  },
  {
    label: 'Internals',
    items: [
      { href: '/docs/06-code-database/', label: 'Code - Database' },
      { href: '/docs/08-transport-websocket/', label: 'Transport WebSocket' },
      { href: '/docs/08-code-transport/', label: 'Code - Transport' },
      { href: '/docs/09-handlers/', label: 'Handlers' },
      { href: '/docs/09-code-handlers/', label: 'Code - Setup & Runtime' },
      { href: '/docs/10-schedulers/', label: 'Schedulers' },
      { href: '/docs/10-code-schedulers/', label: 'Code - Schedulers' },
      { href: '/docs/11-domain/', label: 'Domain' },
      { href: '/docs/11-code-domain/', label: 'Code - Domain' },
      { href: '/docs/12-services/', label: 'Services' },
      { href: '/docs/12-code-services/', label: 'Code - Services' },
      { href: '/docs/16-code-server-di/', label: 'Code - Server & DI' }
    ]
  },
  {
    label: 'Reference',
    items: [
      { href: '/docs/13-dashboard-web/', label: 'Dashboard Web' },
      { href: '/docs/13-code-dashboard-web/', label: 'Code - Dashboard Web' },
      { href: '/docs/14-message-contracts/', label: 'Message Contracts' },
      { href: '/docs/15-troubleshooting/', label: 'Troubleshooting' }
    ]
  }
];

function isActive(href) {
  return href === '/docs/'
    ? currentPath === href
    : currentPath === href || currentPath.startsWith(href);
}
---
{mobile ? (
  <details class="docs-side-mobile docs-panel" open={false}>
    <summary>Browse docs</summary>
    <div class="docs-side-body">
      {groups.map((group) => (
        <section class="docs-side-group">
          <h2>{group.label}</h2>
          <ul>
            {group.items.map((item) => (
              <li>
                <a class:list={['docs-side-link', isActive(item.href) && 'active']} href={item.href}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </details>
) : (
  <nav class="docs-side" aria-label="Documentation sections">
    <div class="docs-side-head">
      <div class="docs-side-title">DOCS</div>
    </div>
    {groups.map((group) => (
      <section class="docs-side-group">
        <h2>{group.label}</h2>
        <ul>
          {group.items.map((item) => (
            <li>
              <a class:list={['docs-side-link', isActive(item.href) && 'active']} href={item.href}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </nav>
)}

<style>
  .docs-side-mobile {
    padding: 1rem;
  }

  .docs-side-head {
    padding: 0.2rem 0 0.8rem;
  }

  .docs-side-title {
    font-size: 1.9rem;
    font-weight: 700;
    color: var(--docs-heading);
  }

  .docs-side-group {
    margin-top: 1.1rem;
  }

  .docs-side-group h2 {
    margin: 0 0 0.7rem;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--docs-text-soft);
  }

  .docs-side-group ul {
    display: grid;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .docs-side-link {
    display: block;
    padding: 0.45rem 0 0.45rem 1rem;
    border-left: 2px solid transparent;
    border-radius: 0;
    color: var(--docs-text-soft);
    text-decoration: none;
    transition: color 140ms ease, border-color 140ms ease;
  }

  .docs-side-link:hover {
    color: var(--docs-heading);
    text-decoration: none;
  }

  .docs-side-link.active {
    color: var(--docs-accent);
    border-left-color: var(--docs-accent);
    font-weight: 700;
    text-shadow: 0 0 16px rgba(154, 216, 255, 0.32);
    filter: drop-shadow(0 0 0.45rem rgba(154, 216, 255, 0.18));
  }

  .docs-side-mobile summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--docs-heading);
    list-style: none;
  }

  .docs-side-mobile summary::-webkit-details-marker {
    display: none;
  }

  .docs-side-body {
    padding-top: 0.85rem;
  }
</style>
