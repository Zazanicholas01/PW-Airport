---
const { currentPath = '/' } = Astro.props;

const navItems = [
  { href: '/docs/', label: 'Docs' },
  { href: '/docs/01-architecture/', label: 'Architecture' },
  { href: '/docs/03-end-to-end-workflows/', label: 'Runtime' },
  { href: '/docs/14-message-contracts/', label: 'Reference' },
  { href: '/', label: 'Dashboard' }
];

function isActive(href) {
  if (href === '/') {
    return currentPath === '/';
  }

  return href === '/docs/'
    ? currentPath === href
    : currentPath === href || currentPath.startsWith(href);
}
---
<header class="docs-topbar-wrap">
  <div class="docs-topbar">
    <a class="docs-brand" href="/docs/">
      <strong>PW-Airport Docs</strong>
    </a>

    <nav class="docs-nav" aria-label="Docs navigation">
      {navItems.map((item) => (
        <a class:list={['docs-nav-link', isActive(item.href) && 'active']} href={item.href}>
          {item.label}
        </a>
      ))}
      <a class="docs-icon" href="/docs/" aria-label="Docs search">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6"></circle>
          <path d="m20 20-4.2-4.2"></path>
        </svg>
      </a>
      <a class="docs-icon" href="/" aria-label="Dashboard home">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="4" y="5" width="16" height="12" rx="2"></rect>
          <path d="M9 20h6"></path>
          <path d="M12 17v3"></path>
        </svg>
      </a>
    </nav>
  </div>
</header>

<style>
  .docs-topbar-wrap {
    position: sticky;
    top: 0;
    z-index: 30;
    padding: 1rem 1rem 0;
    background: linear-gradient(180deg, rgba(11, 13, 18, 0.96), rgba(11, 13, 18, 0.78), transparent);
  }

  .docs-topbar {
    width: min(96rem, calc(100vw - 1.5rem));
    margin: 0 auto;
    padding: 0.2rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .docs-brand {
    color: inherit;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 700;
  }

  .docs-brand:hover {
    text-decoration: none;
  }

  .docs-nav {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem;
  }

  .docs-nav-link {
    padding: 0.4rem 0.55rem;
    color: #f2f4f7;
    text-decoration: none;
    font-weight: 500;
  }

  .docs-nav-link:hover {
    text-decoration: none;
    opacity: 0.82;
  }

  .docs-nav-link.active {
    color: white;
    font-weight: 600;
  }

  .docs-icon {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--docs-border-strong);
    border-radius: 0.6rem;
    color: var(--docs-text);
    text-decoration: none;
  }

  .docs-icon svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .docs-icon:hover {
    text-decoration: none;
    border-color: rgba(255, 255, 255, 0.28);
  }

  @media (max-width: 860px) {
    .docs-topbar {
      width: min(100%, calc(100vw - 1rem));
      flex-direction: column;
      align-items: stretch;
    }

    .docs-nav {
      justify-content: flex-start;
    }
  }
</style>
