---
import DocsSidebar from '../components/DocsSidebar.astro';

const { frontmatter } = Astro.props;
const pageTitle = frontmatter?.title
  ? `${frontmatter.title} | PW-Airport Docs`
  : 'PW-Airport Docs';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <style>
      :root {
        color-scheme: dark;
        --bg-0: #09111a;
        --bg-1: #0f1c29;
        --panel: rgba(15, 28, 41, 0.92);
        --panel-strong: rgba(7, 16, 25, 0.95);
        --text: #ebf3fa;
        --muted: #9fb3c8;
        --line: rgba(255, 255, 255, 0.1);
        --accent: #78d3ff;
        --accent-soft: rgba(120, 211, 255, 0.14);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: Poppins, system-ui, sans-serif;
        color: var(--text);
        background:
          radial-gradient(circle at top left, rgba(120, 211, 255, 0.18), transparent 28rem),
          linear-gradient(180deg, var(--bg-0), var(--bg-1));
      }

      a {
        color: var(--accent);
      }

      .docs-shell {
        display: grid;
        grid-template-columns: 18rem minmax(0, 1fr);
        min-height: 100vh;
      }

      .docs-sidebar {
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
        padding: 1.5rem;
        border-right: 1px solid var(--line);
        background: var(--panel-strong);
        backdrop-filter: blur(18px);
      }

      .docs-main {
        padding: 2rem 2.5rem 4rem;
      }

      .docs-article {
        max-width: 62rem;
        padding: 2rem 2.25rem 3rem;
        border: 1px solid var(--line);
        border-radius: 1.5rem;
        background: var(--panel);
        backdrop-filter: blur(14px);
        box-shadow: 0 18px 60px rgba(0, 0, 0, 0.24);
      }

      .docs-article h1,
      .docs-article h2,
      .docs-article h3 {
        line-height: 1.15;
        letter-spacing: -0.02em;
      }

      .docs-article h1 {
        margin-top: 0;
        font-size: clamp(2.2rem, 4vw, 3.2rem);
      }

      .docs-article p,
      .docs-article li {
        color: var(--text);
        line-height: 1.72;
      }

      .docs-article :is(ul, ol) {
        padding-left: 1.35rem;
      }

      .docs-article code {
        padding: 0.15rem 0.4rem;
        border-radius: 0.45rem;
        background: rgba(255, 255, 255, 0.08);
      }

      .docs-article pre {
        overflow-x: auto;
        padding: 1rem 1.1rem;
        border: 1px solid var(--line);
        border-radius: 1rem;
        background: #081018;
      }

      .docs-article pre code {
        padding: 0;
        background: transparent;
      }

      .docs-article blockquote {
        margin: 1.5rem 0;
        padding: 0.1rem 1rem;
        border-left: 3px solid var(--accent);
        background: var(--accent-soft);
      }

      @media (max-width: 920px) {
        .docs-shell {
          grid-template-columns: 1fr;
        }

        .docs-sidebar {
          position: static;
          height: auto;
          border-right: 0;
          border-bottom: 1px solid var(--line);
        }

        .docs-main {
          padding: 1rem;
        }

        .docs-article {
          padding: 1.4rem;
          border-radius: 1rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="docs-shell">
      <aside class="docs-sidebar">
        <DocsSidebar />
      </aside>
      <main class="docs-main">
        <article class="docs-article">
          <slot />
        </article>
      </main>
    </div>
  </body>
</html>
